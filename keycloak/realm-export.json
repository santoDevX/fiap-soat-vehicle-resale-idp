{
  "realm": "vehicle-resale",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "ADMIN", "description": "Manages vehicles for sale" },
      { "name": "CUSTOMER", "description": "Buys vehicles" },
      {
        "name": "default-roles-vehicle-resale",
        "description": "Role nativa do Keycloak que gerencia os padrões",
        "composite": true,
        "clientRole": false,
        "composites": {
          "realm": [
            "CUSTOMER"
          ]
        }
      }
    ]
  },
  "clients": [
    {
      "clientId": "vehicle-resale-client",
      "publicClient": true,
      "protocol": "openid-connect",
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "redirectUris": ["*"]
    }
  ],
  "users": [
    {
      "username": "admin.demo",
      "email": "admin.demo@vehicleresale.local",
      "firstName": "Admin",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "${SEED_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["ADMIN"]
    },
    {
      "username": "customer.demo",
      "email": "customer.demo@vehicleresale.local",
      "firstName": "Customer",
      "lastName": "Demo",
      "enabled": true,
      "emailVerified": true,
      "credentials": [
        { "type": "password", "value": "${SEED_PASSWORD}", "temporary": false }
      ],
      "realmRoles": ["CUSTOMER"]
    }
  ]
}
